<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_gripper">
  <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

  <!-- Build the UR5e and Robotiq gripper from source xacros, without Gazebo-only plugins. -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
  <xacro:include filename="$(find robot_gripper)/urdf/robotiq_arg2f_85_model_macro.xacro" />

  <link name="world" />
  <xacro:ur_robot name="ur"
                  tf_prefix=""
                  parent="world"
                  joint_limits_parameters_file="$(find ur_description)/config/ur5e/joint_limits.yaml"
                  kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
                  physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
                  visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
                  safety_limits="false"
                  safety_pos_margin="0.15"
                  safety_k_position="20">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <xacro:robotiq_arg2f_85 prefix="" />
  <joint name="gripper_to_robot" type="fixed">
    <parent link="tool0" />
    <child link="robotiq_arg2f_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <xacro:include filename="robot_gripper.ros2_control.xacro" />
  <xacro:robot_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)" />
</robot>
